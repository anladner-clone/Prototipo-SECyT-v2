---
import Layout from "@layouts/Layout.astro";
import LoginBrand from "@components/Login/LoginBrand.astro";
import LoginRoleSelector from "@components/Login/LoginRoleSelector.astro";
import LoginForm from "@components/Login/LoginForm.astro";
import LoginFooter from "@components/Login/LoginFooter.astro";
---

<Layout>
    <main class="login-page">
        <section class="login-page__card" aria-labelledby="login-title">
            <LoginBrand />
            <LoginRoleSelector />
            <LoginForm />
            <LoginFooter />
        </section>
    </main>
</Layout>

<style>
    .login-page {
        display: flex;
        justify-content: center;
        align-items: center;

        min-height: 100dvh;
        max-width: 100dvw;
        padding: 1rem;
    }

    .login-page__card {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
        width: min(100%, 525px);
        min-height: 730px;
        padding: 2.4rem 2.5rem;
        background-color: #fff;
        border-radius: 1.25rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }
</style>
