---
import DashboardLayout from "@layouts/DashboardLayout.astro";
import Dashboard from "@components/main/dashboard/Dashboard.astro";
import Investigadores from "@components/main/investigadores/Investigadores.astro";
import Proyectos from "@components/main/proyectos/Proyectos.astro";

export function getStaticPaths() {
    return [
        {
            params: {
                main: "dashboard",
            },
        },
        {
            params: {
                main: "investigadores",
            },
        },
        {
            params: {
                main: "proyectos",
            },
        },
    ];
}

const { main } = Astro.params;

const pages = {
    dashboard: Dashboard,
    investigadores: Investigadores,
    proyectos: Proyectos,
};

const CurrentPage = pages[main as keyof typeof pages];

if (!CurrentPage) {
    return Astro.redirect("/dashboard");
}
---

<DashboardLayout activeItem={main ?? ""}>
    <CurrentPage />
</DashboardLayout>
