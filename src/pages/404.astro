---
import Layout from "@layouts/Layout.astro";
---

<Layout title="404 - Página no encontrada | UTN San Francisco">
    <svg
        class="error-page__background"
        height="100%"
        width="100%"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
    >
        <defs>
            <pattern
                height="40"
                id="grid"
                patternUnits="userSpaceOnUse"
                width="40"
            >
                <path
                    d="M 40 0 L 0 0 0 40"
                    fill="none"
                    stroke="#002b49"
                    stroke-width="1"></path>
            </pattern>
        </defs>

        <rect fill="url(#grid)" height="100%" width="100%"></rect>
    </svg>

    <main class="error-page">
        <section class="error-page__container">
            <div class="error-page__image" aria-hidden="true">
                <img src="/img/logo-utn-siglas.png" alt="" />
            </div>

            <div class="error-page__content">
                <p class="error-page__code">404</p>

                <h1 class="error-page__title">Página no encontrada</h1>

                <p class="error-page__description">
                    Lo sentimos, el enlace que has solicitado podría estar roto
                    o la página puede haber sido eliminada o movida a otra
                    dirección en el sistema.
                </p>
            </div>

            <nav class="error-page__actions" aria-label="Acciones de la página">
                <a class="error-page__button" href="/"> Volver al inicio </a>

                <a
                    class="error-page__button error-page__button--primary"
                    href="#"
                >
                    Contactar Soporte
                </a>
            </nav>
        </section>
    </main>
</Layout>

<style>
    .error-page__background {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 0;
        opacity: 0.2;
        pointer-events: none;
    }

    .error-page {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-width: 100dvw;
        min-height: 100dvh;
        font-family: "Inter", system-ui, sans-serif;
    }

    .error-page__container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        max-width: 720px;
        padding: 3rem;
        text-align: center;
        background-color: #fff;
        border-radius: 1rem;
        box-shadow: 0 0 15px -3px rgb(0 0 0 / 0.2);
    }

    .error-page__image {
        display: flex;
        justify-content: center;
        max-width: 400px;
    }

    .error-page__image img {
        width: 100%;
        height: auto;
        object-fit: contain;
    }

    .error-page__content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .error-page__code {
        font-size: 8rem;
        font-weight: 800;
        line-height: 1;
        color: #0f172a;
    }

    .error-page__title {
        font-size: 1.5rem;
    }

    .error-page__description {
        max-width: 500px;
        font-size: 1rem;
        color: #0f172ada;
        text-wrap: balance;
    }

    .error-page__actions {
        display: flex;
        gap: 1rem;
    }

    .error-page__button {
        padding: 1rem 2rem;
        background-color: #0072ce;
        border: 2px solid #0072ce;
        color: #fff;
        font-size: 1rem;
        font-weight: bold;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .error-page__button:hover {
        background-color: #005fa3;
        border: 2px solid #005fa3;
    }

    .error-page__button--primary {
        background-color: #fff;
        border: 2px solid #0072ce;
        color: #0072ce;
    }

    .error-page__button--primary:hover {
        background-color: #fff;
        border: 2px solid #005fa3;
        color: #005fa3;
    }
</style>
