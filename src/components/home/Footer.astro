---

---

<footer class="footer">
    <div class="footer__container">
        <div class="footer__brand">
            <img
                alt="UTN San Francisco Logo"
                class="footer__logo"
                src="/img/logo-utn-siglas.png"
            />
            <p class="footer__copyright">
                © 2026 UTN Secretaría de Ciencia y Tecnología. Todos los
                derechos reservados.
            </p>
        </div>
        <div class="footer__nav-group">
            <h4 class="footer__nav-title">Legal</h4>
            <a class="footer__nav-link" href="#">Políticas de Privacidad</a>
            <a class="footer__nav-link" href="#">Términos de Servicio</a>
            <a class="footer__nav-link" href="#">Ética en Investigación</a>
        </div>
        <div class="footer__nav-group">
            <h4 class="footer__nav-title">Recursos</h4>
            <a class="footer__nav-link" href="#">Documentación</a>
            <a class="footer__nav-link" href="#">Portal Institucional</a>
        </div>
        <div class="footer__nav-group">
            <h4 class="footer__nav-title">Soporte</h4>
            <a class="footer__nav-link" href="#">Contactar Soporte</a>
        </div>
    </div>
    <div class="autor">
        <div class="autor__container">
            <p class="autor__text">
                Prototipo desarrollado por <a
                    href="https://linkedin.com/in/anladner"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="autor__link">Ariel Ladner</a
                >
            </p>
        </div>
    </div>
</footer>

<style>
    .footer {
        background-color: var(--color-primary);
        color: var(--color-surface);
        padding: 2rem 1.5rem;
        border-top: 1px solid var(--color-primary-dark);
    }
    .footer__container {
        max-width: 1280px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr;
        gap: 3rem;
    }
    @media (min-width: 768px) {
        .footer__container {
            grid-template-columns: repeat(4, 1fr);
            padding: 0 4rem;
        }
    }
    .footer__brand {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .footer__logo {
        height: 3rem;
        width: auto;
        object-fit: contain;
        filter: brightness(0) invert(1);
        align-self: flex-start;
    }
    .footer__copyright {
        font-size: 0.875rem;
        opacity: 0.8;
        line-height: 1.5;
    }
    .footer__nav-group {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        font-size: 0.875rem;
    }
    .footer__nav-title {
        font-weight: 600;
        margin-bottom: 0.5rem;
    }
    .footer__nav-link {
        color: var(--color-accent-light);
        text-decoration: none;
        opacity: 0.8;
        transition: opacity 0.3s;
    }
    .footer__nav-link:hover {
        opacity: 1;
    }

    .autor {
        padding: 2rem 1.5rem 1rem 1.5rem;
    }
    .autor__container {
        max-width: 1280px;
        margin: 0 auto;
    }
    .autor__text {
        font-size: 0.75rem;
        text-align: center;
    }
    .autor__link {
        color: #48e;
        text-decoration: none;
        font-weight: bold;
        opacity: 0.8;
        transition: opacity 0.3s;
    }

    .autor__link:hover {
        text-decoration: underline;
        opacity: 1;
    }
</style>
