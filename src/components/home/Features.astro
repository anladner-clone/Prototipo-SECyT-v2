---

---

<section class="features" id="features">
    <div class="features__container">
        <header class="features__header">
            <h2 class="features__title">Pilares de la Plataforma</h2>
        </header>
        <div class="features__grid">
            <article class="feature-card">
                <span class="material-symbols-outlined feature-card__icon"
                    >integration_instructions</span
                >
                <h3 class="feature-card__title">Gestión Centralizada</h3>
                <p class="feature-card__description">
                    Reemplace planillas Excel por un flujo de trabajo más
                    agilizado. Unifique todos sus procesos en un solo lugar.
                </p>
            </article>
            <article class="feature-card">
                <span class="material-symbols-outlined feature-card__icon"
                    >recent_actors</span
                >
                <h3 class="feature-card__title">
                    Directorio de Investigadores
                </h3>
                <p class="feature-card__description">
                    Información actualizada de cada investigador de la UTN San
                    Francisco.
                </p>
            </article>
            <article class="feature-card">
                <span class="material-symbols-outlined feature-card__icon"
                    >sim_card_download</span
                >
                <h3 class="feature-card__title">Exportaciones</h3>
                <p class="feature-card__description">
                    Genere informes en PDF y Markdown con un solo clic para una
                    mejor experiencia de trabajo y presentación de resultados.
                </p>
            </article>
        </div>
    </div>
</section>

<style>
    .features {
        background-color: var(--color-surface);
        padding: 7.5rem 1.5rem;
        border-top: 1px solid var(--color-border);
    }
    .features__container {
        max-width: 1280px;
        margin: 0 auto;
    }
    .features__header {
        text-align: center;
        margin-bottom: 4rem;
    }
    .features__title {
        font-size: 2rem;
        font-weight: 700;
        color: var(--color-primary);
    }
    .features__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
    }
    @media (min-width: 768px) {
        .features__grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
    .feature-card {
        background-color: var(--color-background);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        padding: 2rem;
        box-shadow: var(--shadow-sm);
        border-top: 4px solid var(--color-accent);
        transition: scale 0.3s;
    }
    .feature-card:hover {
        scale: 1.01;
    }
    .feature-card__icon {
        color: var(--color-accent);
        font-size: 2.5rem;
        margin-bottom: 1.5rem;
        display: block;
    }
    .feature-card__title {
        font-size: 1.25rem;
        color: var(--color-primary);
        margin-bottom: 0.75rem;
    }
    .feature-card__description {
        font-size: 1rem;
        color: var(--color-text-secondary);
        line-height: 1.5;
    }
</style>
