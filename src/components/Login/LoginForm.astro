---
import Link from "./Link.astro";
---

<form class="login-form">
    <div class="login-form__field">
        <label class="login-form__label" for="email">
            Correo Electrónico
        </label>

        <div class="login-form__input-wrapper">
            <svg
                class="login-form__icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
            >
                <rect
                    x="3"
                    y="5"
                    width="18"
                    height="14"
                    rx="1"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"></rect>
                <path
                    d="m4 7 8 6 8-6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"></path>
            </svg>

            <input
                id="email"
                class="login-form__input"
                type="email"
                name="email"
                placeholder="usuario@facultad.sanfrancisco.utn.edu.ar"
                autocomplete="username"
            />
        </div>
    </div>

    <div class="login-form__field">
        <div class="login-form__label-row">
            <label class="login-form__label" for="password"> Contraseña </label>

            <Link href="/recuperar-contrasena" class="login-form__forgot-link">
                ¿Olvidaste tu contraseña?
            </Link>
        </div>

        <div class="login-form__input-wrapper">
            <svg
                class="login-form__icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
            >
                <rect
                    x="5"
                    y="10"
                    width="14"
                    height="11"
                    rx="1"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"></rect>
                <path
                    d="M8 10V7a4 4 0 0 1 8 0v3"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"></path>
                <circle cx="12" cy="15.5" r="1" fill="currentColor"></circle>
            </svg>

            <input
                id="password"
                class="login-form__input"
                type="password"
                name="password"
                placeholder="••••••••"
                autocomplete="current-password"
            />

            <button
                class="login-form__password-toggle"
                type="button"
                aria-label="Mostrar contraseña"
            >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                        d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"></path>
                    <circle
                        cx="12"
                        cy="12"
                        r="2.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"></circle>
                </svg>
            </button>
        </div>
    </div>

    <Link href="/dashboard" class="login-form__submit">
        <span>Iniciar Sesión</span>

        <svg
            class="login-form__submit-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
        >
            <path
                d="M5 12h13"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"></path>

            <path
                d="m13 6 6 6-6 6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
        </svg>
    </Link>
</form>

<style>
    .login-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .login-form__field {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
    }

    .login-form__label-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .login-form__label {
        color: #111111;
        font-size: 1.05rem;
        font-weight: 500;
    }

    .login-form__input-wrapper {
        display: flex;
        align-items: center;
        width: 100%;
        min-height: 3.3rem;

        border: 2px solid #c5c5c5;
        background-color: #ffffff;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    .login-form__input-wrapper:focus-within {
        border-color: #004874;
        box-shadow: 0 0 0 3px rgba(0, 72, 116, 0.1);
    }

    .login-form__icon {
        flex: 0 0 1.55rem;
        width: 1.55rem;
        height: 1.55rem;
        margin-left: 0.9rem;

        color: #b7b7b7;
    }

    .login-form__input {
        width: 100%;
        min-width: 0;
        padding: 0.8rem 0.75rem;

        border: 0;
        outline: 0;

        background: transparent;
        color: #1d1d1d;

        font: inherit;
        font-size: 1rem;
    }

    .login-form__input::placeholder {
        color: #7b8da0;
        opacity: 1;
    }

    .login-form__password-toggle {
        display: grid;
        place-items: center;

        flex: 0 0 auto;

        width: 3rem;
        height: 3rem;
        padding: 0;

        border: 0;
        background: transparent;

        color: #b7b7b7;
        cursor: pointer;
    }

    .login-form__password-toggle svg {
        width: 1.55rem;
        height: 1.55rem;
    }

    .login-form__submit-icon {
        width: 1.6rem;
        height: 1.6rem;
    }
</style>
