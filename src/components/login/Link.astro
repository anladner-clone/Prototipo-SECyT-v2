---
interface Props {
    href: string;
    class?: string;
    ariaLabel?: string;
}

const { href, class: className = "", ariaLabel } = Astro.props;
---

<a class={className} href={href} aria-label={ariaLabel}>
    <slot />
</a>

<style>
    a {
        color: inherit;
        text-decoration: none;
    }

    a:focus-visible {
        outline: 3px solid rgba(0, 72, 116, 0.35);
        outline-offset: 3px;
    }

    .login-form__submit {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.7rem;

        min-height: 3.6rem;
        padding: 0.75rem 1.25rem;

        background-color: #003452;
        color: #ffffff;

        font-size: 1.05rem;
        font-weight: 500;
        text-decoration: none;

        transition:
            background-color 0.2s ease,
            transform 0.2s ease;
    }

    .login-form__submit:hover {
        background-color: #00263c;
    }

    .login-form__submit:active {
        transform: translateY(1px);
    }

    .login-form__forgot-link {
        color: #1474dc;
        font-size: 0.8rem;
        text-decoration: none;
        white-space: nowrap;
    }

    .login-form__forgot-link:hover {
        text-decoration: underline;
    }
</style>
