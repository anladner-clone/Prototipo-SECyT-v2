---
interface Props {
    investigador: any;
}
const { investigador } = Astro.props;
---

<aside class="sidebar-card">
    <div class="sidebar-card__header">
        <img
            class="sidebar-card__avatar"
            src={`https://ui-avatars.com/api/?name=${investigador.nombre}+${investigador.apellido}&background=random&size=128`}
            alt="Avatar"
        />
        <h2 class="sidebar-card__name">
            {investigador.nombre} {investigador.apellido}
        </h2>
        <span class="sidebar-card__badge"
            >{investigador.rol_institucional || "Investigador"}</span
        >
    </div>

    <div class="sidebar-card__body">
        <div class="data-group">
            <span class="data-group__label">Legajo UTN</span>
            <span class="data-group__value">{investigador.legajo || "N/A"}</span
            >
        </div>
        <div class="data-group">
            <span class="data-group__label">CUIL</span>
            <span class="data-group__value">{investigador.cuil || "N/A"}</span>
        </div>
        <div class="data-group">
            <span class="data-group__label">Categoría UTN</span>
            <span class="data-group__value"
                >{investigador.categoria_utn || "N/A"}</span
            >
        </div>
        <div class="data-group">
            <span class="data-group__label">Categoría CONICET</span>
            <span class="data-group__value"
                >{investigador.categoria_conicet || "N/A"}</span
            >
        </div>
    </div>
</aside>

<aside class="sidebar-card sidebar-card--contact">
    <h3 class="sidebar-card__title">
        <span class="material-symbols-outlined">contact_mail</span> Contacto
    </h3>
    <div class="data-group">
        <span class="data-group__label">Email Institucional</span>
        <span class="data-group__value data-group__value--link"
            >{investigador.email || "N/A"}</span
        >
    </div>
</aside>

<style>
    .sidebar-card {
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        padding: 2rem 1.5rem;
        box-shadow: var(--shadow-sm);
        margin-bottom: 1.5rem;
    }
    .sidebar-card__header {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        border-bottom: 1px solid var(--color-border);
        padding-bottom: 1.5rem;
        margin-bottom: 1.5rem;
    }
    .sidebar-card__avatar {
        width: 100px;
        height: 100px;
        border-radius: var(--radius-sm);
        object-fit: cover;
        margin-bottom: 1rem;
        border: 1px solid var(--color-border);
    }
    .sidebar-card__name {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-primary);
        margin-bottom: 0.5rem;
    }
    .sidebar-card__badge {
        background-color: var(--color-accent-light);
        color: var(--color-accent);
        padding: 0.25rem 0.75rem;
        border-radius: var(--radius-sm);
        font-size: 0.75rem;
        font-weight: 600;
    }
    .sidebar-card__title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.125rem;
        color: var(--color-primary);
        margin-bottom: 1.5rem;
    }
    .sidebar-card__title .material-symbols-outlined {
        font-size: 1.25rem;
    }
    .data-group {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-bottom: 1.25rem;
    }
    .data-group:last-child {
        margin-bottom: 0;
    }
    .data-group__label {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--color-text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .data-group__value {
        font-size: 1rem;
        color: var(--color-text);
    }
    .data-group__value--link {
        color: var(--color-accent);
        cursor: pointer;
    }
</style>
