---
import fs from "node:fs";
import { parse } from "csv-parse/sync";
import ProyectosHeader from "./ProyectosHeader.astro";
import ProyectosTable from "./ProyectosTable.astro";

const csvProyectos = fs.readFileSync("src/data/proyectos.csv", "utf-8");
const csvInvestigadores = fs.readFileSync(
    "src/data/investigadores.csv",
    "utf-8",
);

const investigadores = parse(csvInvestigadores, {
    columns: true,
    skip_empty_lines: true,
}).map((row: any) => {
    return {
        id: Number(row.id_investigador),
        nombre: row.nombre,
        apellido: row.apellido,
    };
});

const records = parse(csvProyectos, {
    columns: true,
    skip_empty_lines: true,
});

const proyectos = records.map((row: any) => {
    const director = investigadores.find(
        (investigador: any) => investigador.id === Number(row.director),
    );
    return {
        id: Number(row.id_proyecto),
        nombre: row.titulo,
        director: (director?.nombre || "") + " " + (director?.apellido || ""),
        area: row.area,
        investigadores: Number(row.investigadores),
        estado: row.estado,
        periodo: row.periodo,
    };
});
---

<section class="proyectos">
    <ProyectosHeader total={proyectos.length} />

    <ProyectosTable proyectos={proyectos} />
</section>

<style>
    .proyectos {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }
</style>
