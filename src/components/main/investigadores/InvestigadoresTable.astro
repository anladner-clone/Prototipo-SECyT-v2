---
export interface Investigador {
    id: number;
    nombre: string;
    correo: string;
    rol: string;
    proyectos: number;
    estado: "Activo" | "Inactivo";
}

interface Props {
    investigadores: Investigador[];
}

const { investigadores } = Astro.props;
---

<section class="investigadores-table">
    <div class="investigadores-table__toolbar">
        <div class="investigadores-table__search">
            <svg
                class="investigadores-table__search-icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
            >
                <circle
                    cx="11"
                    cy="11"
                    r="6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"></circle>

                <path
                    d="m16 16 4 4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"></path>
            </svg>

            <input
                class="investigadores-table__search-input"
                type="search"
                placeholder="Buscar investigador..."
                aria-label="Buscar investigador"
            />
        </div>

        <div class="investigadores-table__actions">
            <button class="investigadores-table__filter" type="button">
                Filtrar
            </button>

            <button class="investigadores-table__add" type="button">
                + Nuevo investigador
            </button>
        </div>
    </div>

    <div class="investigadores-table__wrapper">
        <table class="investigadores-table__table">
            <thead class="investigadores-table__head">
                <tr>
                    <th>Investigador</th>
                    <th>Rol</th>
                    <th>Proyectos</th>
                    <th>Estado</th>
                    <th class="investigadores-table__action-column">
                        Acción
                    </th>
                </tr>
            </thead>

            <tbody>
                {
                    investigadores.map((investigador) => (
                        <tr class="investigadores-table__row">
                            <td>
                                <div class="investigadores-table__person">
                                    <div class="investigadores-table__avatar">
                                        {investigador.nombre.charAt(0)}
                                    </div>

                                    <div class="investigadores-table__person-info">
                                        <strong class="investigadores-table__name">
                                            {investigador.nombre}
                                        </strong>

                                        <span class="investigadores-table__email">
                                            {investigador.correo}
                                        </span>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <span class="investigadores-table__rol">
                                    {investigador.rol}
                                </span>
                            </td>

                            <td>
                                <span class="investigadores-table__projects">
                                    {investigador.proyectos}
                                </span>
                            </td>

                            <td>
                                <span
                                    class:list={[
                                        "investigadores-table__status",
                                        {
                                            "investigadores-table__status--active":
                                                investigador.estado ===
                                                "Activo",
                                            "investigadores-table__status--inactive":
                                                investigador.estado ===
                                                "Inactivo",
                                        },
                                    ]}
                                >
                                    {investigador.estado}
                                </span>
                            </td>

                            <td class="investigadores-table__action-column">
                                <a
                                    class="investigadores-table__view"
                                    href={`/user/${investigador.id}`}
                                    aria-label={`Ver investigador ${investigador.nombre}`}
                                >
                                    Ver
                                    <span class="material-symbols-outlined">
                                        visibility
                                    </span>
                                </a>
                            </td>
                        </tr>
                    ))
                }
            </tbody>
        </table>
    </div>
</section>

<style>
    .investigadores-table {
        overflow: hidden;

        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);

        box-shadow: var(--shadow-sm);
    }

    .investigadores-table__toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;

        padding: 18px;

        border-bottom: 1px solid var(--color-border);
    }

    .investigadores-table__search {
        position: relative;

        width: min(100%, 360px);
    }

    .investigadores-table__search-icon {
        position: absolute;
        top: 50%;
        left: 13px;

        width: 17px;
        height: 17px;

        color: var(--color-text-muted);

        transform: translateY(-50%);
    }

    .investigadores-table__search-input {
        width: 100%;

        padding: 10px 12px 10px 38px;

        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);

        outline: none;

        background-color: #fafafd;
        color: var(--color-text);

        font-size: 12px;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    .investigadores-table__search-input::placeholder {
        color: var(--color-text-muted);
    }

    .investigadores-table__search-input:focus {
        border-color: var(--color-accent);

        box-shadow: 0 0 0 3px var(--color-accent-light);
    }

    .investigadores-table__actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .investigadores-table__filter,
    .investigadores-table__add {
        min-height: 38px;

        padding: 0 14px;

        border-radius: var(--radius-sm);

        font-size: 12px;
        font-weight: 600;

        cursor: pointer;

        transition:
            background-color 0.2s ease,
            border-color 0.2s ease;
    }

    .investigadores-table__filter {
        border: 1px solid var(--color-border);

        background-color: var(--color-surface);
        color: var(--color-text-secondary);
    }

    .investigadores-table__filter:hover {
        background-color: #f7f7fa;
    }

    .investigadores-table__add {
        border: 1px solid var(--color-primary);

        background-color: var(--color-primary);
        color: #ffffff;
    }

    .investigadores-table__add:hover {
        background-color: var(--color-primary-dark);
    }

    .investigadores-table__wrapper {
        width: 100%;
        max-height: 500px;
        overflow-x: auto;
        overflow-y: auto;
    }

    .investigadores-table__table {
        width: 100%;
        min-width: 760px;

        border-collapse: collapse;
    }

    .investigadores-table__head {
        background-color: #fafafd;
        position: sticky;
        top: 0;
        z-index: 1;
    }

    .investigadores-table__head th {
        padding: 14px 18px;

        border-bottom: 1px solid var(--color-border);

        color: var(--color-text-muted);

        font-size: 10px;
        font-weight: 700;
        text-align: left;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .investigadores-table__row {
        border-bottom: 1px solid var(--color-border);

        transition: background-color 0.2s ease;
    }

    .investigadores-table__row:last-child {
        border-bottom: 0;
    }

    .investigadores-table__row:hover {
        background-color: #fafafd;
    }

    .investigadores-table__row td {
        padding: 16px 18px;

        color: var(--color-text-secondary);

        font-size: 12px;
    }

    .investigadores-table__person {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .investigadores-table__avatar {
        display: grid;
        place-items: center;

        width: 38px;
        height: 38px;

        flex-shrink: 0;

        border-radius: 50%;

        background-color: var(--color-accent-light);
        color: var(--color-primary);

        font-size: 13px;
        font-weight: 700;
    }

    .investigadores-table__person-info {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .investigadores-table__name {
        color: var(--color-text);

        font-size: 12px;
        font-weight: 600;
    }

    .investigadores-table__email {
        max-width: 250px;
        margin-top: 3px;

        overflow: hidden;

        color: var(--color-text-muted);

        font-size: 10px;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .investigadores-table__rol {
        color: var(--color-text-secondary);
    }

    .investigadores-table__projects {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        min-width: 28px;
        min-height: 28px;
        padding: 0 8px;

        border-radius: 8px;

        background-color: var(--color-accent-light);
        color: var(--color-primary);

        font-weight: 700;
    }

    .investigadores-table__status {
        display: inline-flex;

        padding: 5px 10px;

        border-radius: 20px;

        font-size: 10px;
        font-weight: 600;
    }

    .investigadores-table__status--active {
        background-color: #e0f5ef;
        color: #3c8978;
    }

    .investigadores-table__status--inactive {
        background-color: #f7e7e9;
        color: #b26570;
    }

    .investigadores-table__action-column {
        text-align: right !important;
    }

    .investigadores-table__view {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        text-decoration: none;

        padding: 6px 10px;

        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);

        background-color: var(--color-surface);
        color: var(--color-text-secondary);

        font-size: 11px;
        font-weight: 600;

        cursor: pointer;
    }

    .investigadores-table__view:hover {
        border-color: var(--color-accent);

        color: var(--color-primary);
    }

    @media (max-width: 700px) {
        .investigadores-table__toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .investigadores-table__search {
            width: 100%;
        }

        .investigadores-table__actions {
            width: 100%;
        }

        .investigadores-table__filter,
        .investigadores-table__add {
            flex: 1;
        }
    }
</style>
