---
import Layout from "@layouts/Layout.astro";
import Sidebar from "@components/main/Sidebar.astro";

export interface Props {
    activeItem: string;
    title?: string;
}

const { activeItem, title = "Sistema de Gestión" } = Astro.props;
---

<Layout title={title}>
    <div class="main-layout">
        <Sidebar activeItem={activeItem} />

        <main class="main-layout__content">
            <header class="main-layout__topbar">
                <div class="main-layout__breadcrumb">Sistema de Gestión</div>

                <div class="main-layout__user">
                    <span class="main-layout__user-name"> Admin </span>

                    <span class="main-layout__user-avatar"> A </span>
                </div>
            </header>

            <section class="main-layout__page">
                <slot />
            </section>
        </main>
    </div>
</Layout>

<style>
    .main-layout {
        display: grid;
        grid-template-columns: var(--sidebar-width) minmax(0, 1fr);

        width: 100%;
        height: 100dvh;
        overflow: hidden;
    }

    .main-layout__content {
        min-width: 0;
        min-height: calc(100vh - 40px);
        border-radius: 0 var(--radius-lg) var(--radius-lg) 0;

        padding: 0 1.5rem;
        overflow: auto;
    }

    .main-layout__topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;

        min-height: 64px;
        padding: 0 4px;
    }

    .main-layout__breadcrumb {
        color: var(--color-text-secondary);

        font-size: 13px;
        font-weight: 500;
    }

    .main-layout__user {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .main-layout__user-name {
        color: var(--color-text);

        font-size: 12px;
        font-weight: 600;
    }

    .main-layout__user-avatar {
        display: grid;
        place-items: center;

        width: 36px;
        height: 36px;

        border-radius: 50%;

        background-color: var(--color-primary);
        color: #ffffff;

        font-size: 12px;
        font-weight: 700;
    }

    .main-layout__page {
        padding: 4px;
    }

    @media (max-width: 700px) {
        .main-layout {
            grid-template-columns: 1fr;
            gap: 16px;

            padding: 12px;
        }

        .main-layout__content {
            min-height: auto;
        }

        .main-layout__topbar {
            min-height: 52px;
        }

        .main-layout__user-name {
            display: none;
        }
    }
</style>
